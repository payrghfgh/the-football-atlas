# The Football Atlas needs no API keys to run.
# Every variable below is optional; copy this file to `.env.local` only if you
# change the defaults. Never commit real values.

# Optional: absolute site URL used for Open Graph / canonical tags.
# Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Optional: path to an alternate dataset file, relative to the project root.
# Default: src/data/players.json
# ATLAS_DATASET_PATH=
